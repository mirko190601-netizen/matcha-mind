            "value": "Ab Matcha: rückwärts, von der letzten Kanne zur ersten."
          }
        }
      }
    },
    "game.teapotRow.instruction.page1.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merk dir die Reihe"
          }
        }
      }
    },
    "game.teapotRow.instruction.page1.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar Teekannen leuchten kurz nacheinander auf. Schau genau hin, in welcher Reihenfolge."
          }
        }
      }
    },
    "game.teapotRow.instruction.page2.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp sie nach"
          }
        }
      }
    },
    "game.teapotRow.instruction.page2.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe die Kannen in der gezeigten Reihenfolge an. Ab der Matcha-Stufe geht es rückwärts, von der letzten zur ersten."
          }
        }
      }
    },
    "game.teapotRow.instruction.page3.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer dein Tempo"
          }
        }
      }
    },
    "game.teapotRow.instruction.page3.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast so lange Zeit, wie du brauchst. Nach ein paar guten Runden wird die Reihe länger."
          }
        }
      }
    },
    "game.fireflyPond.name": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glühwürmchen am Teich"
          }
        }
      }
    },
    "game.fireflyPond.rule1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe nur Glühwürmchen in der Zielfarbe an."
          }
        }
      }
    },
    "game.fireflyPond.rule2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falter und andere Farben lässt du einfach vorbeiziehen."
          }
        }
      }
    },
    "game.fireflyPond.rule3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab Matcha: Die Zielfarbe kann mitten in der Runde wechseln."
          }
        }
      }
    },
    "game.fireflyPond.instruction.page1.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine Farbe zählt"
          }
        }
      }
    },
    "game.fireflyPond.instruction.page1.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Teich blinken Glühwürmchen und Falter auf. Du suchst dir nur eine bestimmte Farbe aus."
          }
        }
      }
    },
    "game.fireflyPond.instruction.page2.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp nur das Richtige"
          }
        }
      }
    },
    "game.fireflyPond.instruction.page2.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe, sobald du die Zielfarbe siehst. Falter und andere Farben lässt du einfach vorbeiziehen."
          }
        }
      }
    },
    "game.fireflyPond.instruction.page3.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib wach"
          }
        }
      }
    },
    "game.fireflyPond.instruction.page3.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab der Matcha-Stufe wechselt die Zielfarbe mitten in der Runde. Schau immer wieder genau hin."
          }
        }
      }
    },
    "game.mosaicBed.name": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mosaik-Beet"
          }
        }
      }
    },
    "game.mosaicBed.rule1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Reihe zeigt jede Pflanze genau einmal."
          }
        }
      }
    },
    "game.mosaicBed.rule2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Spalte zeigt jede Pflanze genau einmal."
          }
        }
      }
    },
    "game.mosaicBed.rule3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Pflanzen mögen sich nicht und dürfen nie direkt nebeneinander stehen."
          }
        }
      }
    },
    "game.mosaicBed.rule4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ein leeres Feld an, um eine Pflanze zu setzen oder zu wechseln."
          }
        }
      }
    },
    "game.mosaicBed.instruction.page1.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Beet braucht Ordnung"
          }
        }
      }
    },
    "game.mosaicBed.instruction.page1.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In jedem Beet gibt es feste Plätze für Pflanzen. Einige stehen schon da, die leeren Felder füllst du aus."
          }
        }
      }
    },
    "game.mosaicBed.instruction.page2.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reihe und Spalte zählen"
          }
        }
      }
    },
    "game.mosaicBed.instruction.page2.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Reihe und jede Spalte zeigt jede Pflanzenart genau einmal - nie doppelt."
          }
        }
      }
    },
    "game.mosaicBed.instruction.page3.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachbarn beachten"
          }
        }
      }
    },
    "game.mosaicBed.instruction.page3.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Pflanzen vertragen sich nicht nebeneinander. Finde die eine Lösung, die zu allen Regeln passt."
          }
        }
      }
    },
    "game.mosaicBed.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis"
          }
        }
      }
    },
