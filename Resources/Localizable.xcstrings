    "notification.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Matcha Mind"
          }
        }
      }
    },
    "notification.daily.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Teegarten ist etwas aufgeblüht. Magst du nachsehen?"
          }
        }
      }
    },
    "notification.return3.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Bambushain raschelt es. Magst du mal reinschauen?"
          }
        }
      }
    },
    "notification.return7.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fuchs war wieder im Garten. Schau gern vorbei, wenn du Lust hast."
          }
        }
      }
    },
    "notification.invitation.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du magst: Eine kleine Teepause im Garten wartet auf dich."
          }
        }
      }
    },
    "onboarding.welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei Matcha Mind"
          }
        }
      }
    },
