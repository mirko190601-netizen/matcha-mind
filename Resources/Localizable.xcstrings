    "game.bambooMath.name": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambus-Rechnen"
          }
        }
      }
    },
    "game.bambooMath.rule1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse die ganze Rechenkette im Kopf."
          }
        }
      }
    },
    "game.bambooMath.rule2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe dein Ergebnis über das Zahlenpad ein."
          }
        }
      }
    },
    "game.bambooMath.rule3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige mit dem Prüfen-Knopf – dann kommt die nächste Kette."
          }
        }
      }
    },
    "game.bambooMath.instruction.page1.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechenketten lösen"
          }
        }
      }
    },
    "game.bambooMath.instruction.page1.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst eine ganze Rechenkette auf einmal, zum Beispiel 12 + 5 − 3. Rechne sie im Kopf von links nach rechts durch."
          }
        }
      }
    },
    "game.bambooMath.instruction.page2.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwort eintippen"
          }
        }
      }
    },
    "game.bambooMath.instruction.page2.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe dein Endergebnis über das Zahlenpad ein und bestätige mit dem Prüfen-Knopf."
          }
        }
      }
    },
    "game.bambooMath.instruction.page3.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer eine neue Kette"
          }
        }
      }
    },
    "game.bambooMath.instruction.page3.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jeder Antwort kommt sofort die nächste Kette – so lange, bis die Runde vorbei ist."
          }
        }
      }
    },
