    "game.teaLeafSort.name": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teeblätter sortieren"
          }
        }
      }
    },
    "game.teaLeafSort.rule1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiere die Teeblatt-Karte zur passenden Ablage."
          }
        }
      }
    },
    "game.teaLeafSort.rule2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach ein paar richtigen Zuordnungen in Folge ändert sich die Regel."
          }
        }
      }
    },
    "game.teaLeafSort.rule3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab Oolong kommt der Wechsel ohne Vorwarnung."
          }
        }
      }
    },
    "game.teaLeafSort.rule4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab Matcha zählen zwei Eigenschaften gleichzeitig."
          }
        }
      }
    },
    "game.teaLeafSort.instruction.page1.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde das passende Muster"
          }
        }
      }
    },
    "game.teaLeafSort.instruction.page1.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Teeblatt hat eine Farbe, eine Form und eine Anzahl. Du legst es zu der Ablage, die gerade passt."
          }
        }
      }
    },
    "game.teaLeafSort.instruction.page2.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regel kann wechseln"
          }
        }
      }
    },
    "game.teaLeafSort.instruction.page2.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach ein paar richtigen Zuordnungen gilt plötzlich eine andere Eigenschaft. Achte auf deine Rückmeldung."
          }
        }
      }
    },
    "game.teaLeafSort.instruction.page3.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib flexibel"
          }
        }
      }
    },
    "game.teaLeafSort.instruction.page3.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab Oolong kommt der Wechsel ohne Vorwarnung, ab Matcha zählen sogar zwei Eigenschaften gleichzeitig."
          }
        }
      }
    },
    "game.teaLeafSort.ruleChanging": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regel ändert sich gleich!"
          }
        }
      }
    },
